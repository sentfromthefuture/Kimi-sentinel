# Server
PORT=4000
# Supabase Postgres: Dashboard -> Connect -> "Session pooler" connection string (works over IPv4,
# e.g. Codespaces). URL-encode special characters in the password. Never commit the real value.
DATABASE_URL=postgresql://postgres.mswflpbfcqgwgcaslbyc:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
APP_SECRET=change-me-to-a-long-random-string
WEB_ORIGIN=http://localhost:5173

# Supabase Auth. The anon key is public by design (it ships in the browser bundle); the
# service_role key is NOT needed and must never be put here.
SUPABASE_URL=https://mswflpbfcqgwgcaslbyc.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1zd2ZscGJmY3Fnd2djYXNsYnljIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTI0MDE5NDUsImV4cCI6MjEwNzk3Nzk0NX0.V5vxObepM1Y4vr0MusZ2V_ZIogD5KL847X3VPoCFsmw
# Same two values for the web app (Vite only exposes VITE_-prefixed variables)
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# Credential encryption for integration secrets (32-byte key, base64)
CREDENTIAL_KEY=

# AI provider (optional - falls back to built-in heuristic investigator)
AI_PROVIDER=heuristic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
